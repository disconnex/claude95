/* claude95.rc - resources for the Windows 95 Claude client */
#include <windows.h>
#include "resource.h"

IDI_APP ICON "claude95.ico"

IDR_MENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New Chat\tCtrl+N",          IDM_NEWCHAT
        MENUITEM "&Save Transcript...\tCtrl+S", IDM_SAVE
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                      IDM_EXIT
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "&Copy\tCtrl+C",              IDM_COPY
        MENUITEM "Select &All\tCtrl+A",        IDM_SELECTALL
        MENUITEM SEPARATOR
        MENUITEM "Writing &Assist...", IDM_ASSIST
    END
    POPUP "&Options"
    BEGIN
        MENUITEM "&Gateway...",                IDM_GATEWAY
        MENUITEM "Writing Assist &Hotkey...",  IDM_HOTKEY
        MENUITEM "Today's &Usage",             IDM_USAGE
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About Claude 95",           IDM_ABOUT
    END
END

IDR_ACCEL ACCELERATORS
BEGIN
    "N", IDM_NEWCHAT,   VIRTKEY, CONTROL
    "S", IDM_SAVE,      VIRTKEY, CONTROL
    "C", IDM_COPY,      VIRTKEY, CONTROL
    "A", IDM_SELECTALL, VIRTKEY, CONTROL
END

IDD_GATEWAY DIALOG 0, 0, 200, 86
STYLE DS_MODALFRAME | DS_3DLOOK | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Gateway"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "Address of the computer running the claude95 gateway:", -1, 7, 7, 186, 10
    LTEXT           "&Server:", -1, 7, 26, 40, 8
    EDITTEXT        IDC_SERVER, 50, 24, 143, 12, ES_AUTOHSCROLL
    LTEXT           "&Port:", -1, 7, 44, 40, 8
    EDITTEXT        IDC_PORT, 50, 42, 40, 12, ES_NUMBER
    DEFPUSHBUTTON   "OK", IDOK, 89, 65, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 143, 65, 50, 14
END

IDD_ASSIST DIALOG 0, 0, 300, 252
STYLE DS_MODALFRAME | DS_3DLOOK | DS_CENTER | DS_SETFOREGROUND | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Claude 95 - Writing Assist"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "&Text:", -1, 7, 7, 100, 8
    EDITTEXT        IDC_ATEXT, 7, 17, 286, 58, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_TABSTOP
    LTEXT           "&Claude should:", -1, 7, 83, 52, 8
    COMBOBOX        IDC_ACTION, 60, 81, 130, 150, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "...or &tell Claude what to do:", -1, 7, 100, 120, 8
    EDITTEXT        IDC_INSTR, 7, 110, 230, 12, ES_AUTOHSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "&Ask Claude", IDC_GO, 243, 109, 50, 14
    LTEXT           "&Result (you can edit it before using it):", -1, 7, 129, 200, 8
    EDITTEXT        IDC_RESULT, 7, 139, 286, 72, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_ASTATUS, 7, 215, 286, 10, SS_NOPREFIX
    PUSHBUTTON      "&Replace Text", IDC_REPLACE, 7, 231, 56, 14
    PUSHBUTTON      "&Insert After", IDC_INSERT, 67, 231, 56, 14
    PUSHBUTTON      "Cop&y", IDC_COPYRESULT, 127, 231, 50, 14
    PUSHBUTTON      "Close", IDCANCEL, 243, 231, 50, 14
END

IDD_HOTKEY DIALOG 0, 0, 210, 96
STYLE DS_MODALFRAME | DS_3DLOOK | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Writing Assist Hotkey"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "Click in the box and press the keys you want for Writing Assist, for example Ctrl+Alt+W.", -1, 7, 7, 196, 18
    CONTROL         "", IDC_HOTKEY, "msctls_hotkey32", WS_BORDER | WS_TABSTOP, 7, 30, 120, 13
    LTEXT           "Avoid keys your PC itself uses: many 90s BIOSes use Ctrl+Alt with Space, Esc or Ins for suspend or setup.", -1, 7, 50, 196, 18
    DEFPUSHBUTTON   "OK", IDOK, 99, 75, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 153, 75, 50, 14
END

1 VERSIONINFO
FILEVERSION 0,3,2,0
PRODUCTVERSION 0,3,2,0
FILEOS VOS__WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4"
        BEGIN
            VALUE "FileDescription", "Claude 95 - chat with Claude from Windows 95"
            VALUE "FileVersion", "0.3.2"
            VALUE "InternalName", "claude95"
            VALUE "OriginalFilename", "CLAUDE95.EXE"
            VALUE "ProductName", "Claude 95"
            VALUE "ProductVersion", "0.3.2"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END
