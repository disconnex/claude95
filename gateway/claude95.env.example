# claude95 gateway settings. Copy to claude95.env (or /etc/claude95/claude95.env
# when installed with deploy.sh) and fill in. Never commit the real file.

# Your Anthropic API key, from https://console.anthropic.com/
ANTHROPIC_API_KEY=PASTE-KEY-HERE

# Who may connect: the Windows 95 PC's address. Comma-separated addresses or
# networks, e.g. 192.168.1.50 or 192.168.1.0/24. Required. Everyone else gets 403.
C95_ALLOW=192.168.1.50

# Address and port to listen on. 0.0.0.0 means every network interface.
# Keep the gateway on your local network: it speaks plain HTTP.
#C95_HOST=0.0.0.0
#C95_PORT=8095

# The model. Haiku is fast and cheap; claude-sonnet-5-5 or claude-opus-5-5 are
# smarter and cost more.
#C95_MODEL=claude-haiku-5-5
#C95_EFFORT=medium

# Daily limits, so nothing runs away with your credits. Web searches are the
# expensive part (about 1 cent each); a chat message is a fraction of a cent.
#C95_DAILY_MESSAGES=300
#C95_DAILY_SEARCHES=40

# A line about your machine, so Claude knows what it's running on.
#C95_MACHINE=a 1996 Pentium 166 with 32MB of RAM running Windows 95 OSR2
